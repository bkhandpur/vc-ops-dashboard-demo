{
  "name": "vc-ops-dashboard-demo",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "description": "Public, synthetic-data demonstration build of an internal VC operations dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "node --experimental-strip-types scripts/generate-seed.ts",
    "coverage": "node --experimental-strip-types scripts/probe-coverage.ts",
    "preview:sunburst": "node --experimental-strip-types scripts/preview-sunburst.ts",
    "check:docs": "node --experimental-strip-types scripts/check-coverage-docs.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs README.md content/help .github",
    "format:check": "prettier --check app components lib scripts tests *.ts *.mjs README.md content/help .github"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "next": "^16.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
